{
	"compilerOptions": {
		"target": "ESNext", // 目标 JavaScript 版本，支持 ES6/ES2015+
		"module": "ESNext", // 模块系统，适合 Node.js 或使用 CommonJS 模块的项目
		"strict": true, // 启用严格模式，推荐开启
		"esModuleInterop": true, // 启用 ES 模块与 CommonJS 模块之间的互操作性
		"skipLibCheck": true, // 跳过库文件的类型检查，加速编译
		"forceConsistentCasingInFileNames": true, // 强制在文件名大小写一致
		"resolveJsonModule": true, // 允许导入 .json 文件
		"noImplicitAny": true, // 不允许隐式的 `any` 类型
		"moduleResolution": "node", // 模块解析策略，推荐使用 `node`
		"allowJs": true, // 允许编译 JavaScript 文件
		"skipDefaultLibCheck": true, // 跳过默认库文件检查
		"baseUrl": "./packages"
	}
}
